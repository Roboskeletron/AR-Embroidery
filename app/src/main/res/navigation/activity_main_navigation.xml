<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main_navigation"
    app:startDestination="@id/tryOnFragment">

    <fragment
        android:id="@+id/tryOnFragment"
        android:name="ru.vsu.arembroidery.views.TryOnFragment"
        android:label="fragment_try_on"
        tools:layout="@layout/fragment_try_on" >
        <action
            android:id="@+id/action_tryOnFragment_to_designsFragment"
            app:destination="@id/designsFragment" />
        <action
            android:id="@+id/action_tryOnFragment_to_photoReviewFragment"
            app:destination="@id/photoReviewFragment" />
    </fragment>
    <fragment
        android:id="@+id/designsFragment"
        android:name="ru.vsu.arembroidery.views.DesignsFragment"
        android:label="Select embroidery"
        tools:layout="@layout/fragment_designs" />
    <fragment
        android:id="@+id/photoReviewFragment"
        android:name="ru.vsu.arembroidery.views.PhotoReviewFragment"
        android:label=""
        tools:layout="@layout/fragment_designs" >
        <argument
            android:name="photoUri"
            app:argType="string" />
    </fragment>
</navigation>